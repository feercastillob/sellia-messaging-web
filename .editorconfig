# EditorConfig ayuda a mantener un estilo de codificación consistente entre editores
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100
[*.md]
trim_trailing_whitespace = false
[*.{yml,yaml}]
indent_size = 2
[*.{json,js,jsx,ts,tsx,vue}]
quote_type = single
indent_size = 2
[*.{html,css,scss}]
indent_size = 2
[*.{env,config}]
insert_final_newline = true
